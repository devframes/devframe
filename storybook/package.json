{
  "name": "@devframes/storybook",
  "type": "module",
  "version": "0.7.15",
  "private": true,
  "description": "Unified Storybook host — a devframe hub that docks every plugin's Storybook (React, Vue, Svelte, Solid, vanilla), spawning each `storybook dev` on demand.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "storybook:build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antfu/design": "catalog:frontend",
    "@devframes/hub": "workspace:*",
    "@devframes/plugin-terminals": "workspace:*",
    "colorjs.io": "catalog:frontend",
    "devframe": "workspace:*",
    "iframe-pane": "catalog:frontend"
  },
  "devDependencies": {
    "@iconify-json/ph": "catalog:frontend",
    "get-port-please": "catalog:deps",
    "pathe": "catalog:deps",
    "storybook": "catalog:storybook",
    "unocss": "catalog:frontend",
    "vite": "catalog:build"
  }
}
