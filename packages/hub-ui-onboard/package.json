{
  "name": "@devframes/hub-ui-onboard",
  "type": "module",
  "version": "1.2.3",
  "description": "A tiny stand-in for the devframe hub UI: a floating button that installs it on demand.",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/devframes/devframe#readme",
  "repository": {
    "directory": "packages/hub-ui-onboard",
    "type": "git",
    "url": "git+https://github.com/devframes/devframe.git"
  },
  "bugs": "https://github.com/devframes/devframe/issues",
  "keywords": [
    "devtools",
    "devframe",
    "hub",
    "onboard"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:css && tsdown && vite build --config vite.client.config.ts",
    "build:css": "tsx scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "turbo run build --filter=@devframes/hub-ui-onboard",
    "play": "pnpm run build:css && pnpm -C playground play"
  },
  "dependencies": {
    "nostics": "catalog:deps",
    "package-manager-detector": "catalog:deps",
    "tinyexec": "catalog:deps"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsdown": "catalog:build",
    "tsx": "catalog:build",
    "unocss": "catalog:frontend",
    "vite": "catalog:build",
    "vitest": "catalog:testing"
  }
}
