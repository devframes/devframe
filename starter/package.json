{
  "name": "devframe-starter",
  "type": "module",
  "version": "1.3.2",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "Self-contained starter for a single devframe integration: a vanilla-TS Vite client, single + hub playgrounds, and unit + e2e tests.",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/devframes/devframe/tree/main/starter",
  "repository": {
    "directory": "starter",
    "type": "git",
    "url": "git+https://github.com/devframes/devframe.git"
  },
  "bugs": "https://github.com/devframes/devframe/issues",
  "keywords": [
    "devframe",
    "devtools",
    "starter",
    "template"
  ],
  "main": "src/devframe.ts",
  "bin": {
    "devframe-starter": "./bin.mjs"
  },
  "scripts": {
    "dev": "node bin.mjs",
    "build": "vite build --config src/client/vite.config.ts",
    "cli:build": "node bin.mjs build --out-dir dist/static",
    "play:single": "vite --config playground/single/vite.config.ts",
    "play:hub": "vite --config playground/hub/vite.config.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "dependencies": {
    "@devframes/hub": "^1.3.2",
    "@devframes/hub-ui": "^1.3.2",
    "@devframes/vite": "^1.3.2",
    "devframe": "^1.3.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  }
}
