{
  "name": "hub-rsbuild-minimal",
  "type": "module",
  "version": "0.8.2",
  "private": true,
  "description": "Minimal Rsbuild host for @devframes/hub — one initHub() handler mounted as dev middleware, UI from @devframes/hub-ui.",
  "homepage": "https://github.com/devframes/devframe/tree/main/examples/hub-rsbuild-minimal",
  "scripts": {
    "dev": "rsbuild dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devframes/hub": "workspace:*",
    "@devframes/hub-ui": "workspace:*",
    "@devframes/json-render": "workspace:*",
    "@devframes/json-render-ui": "workspace:*",
    "@devframes/plugin-inspect": "workspace:*",
    "@devframes/plugin-messages": "workspace:*",
    "devframe": "workspace:*"
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:build",
    "@types/node": "catalog:types"
  }
}
