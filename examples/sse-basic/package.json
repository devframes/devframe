{
  "name": "sse-basic",
  "type": "module",
  "version": "0.9.9",
  "private": true,
  "description": "Minimal devframe that carries every RPC frame over plain HTTP with SSE.",
  "homepage": "https://github.com/devframes/devframe/tree/main/examples/sse-basic",
  "scripts": {
    "build": "vite build --config app/vite.config.ts",
    "dev": "vite --config app/vite.config.ts --host",
    "play": "pnpm run build && node playgrounds/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antfu/design": "catalog:frontend",
    "devframe": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/ph": "catalog:frontend",
    "@types/node": "catalog:types",
    "h3": "catalog:deps",
    "unocss": "catalog:frontend",
    "vite": "catalog:build"
  }
}
