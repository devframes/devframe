{
  "name": "hub-vite-minimal",
  "type": "module",
  "version": "0.9.0-beta.1",
  "private": true,
  "description": "Minimal Vite host that mounts the devframe hub as dev middleware.",
  "homepage": "https://github.com/devframes/devframe/tree/main/examples/hub-vite-minimal",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devframes/hub": "workspace:*",
    "@devframes/hub-ui": "workspace:*",
    "@devframes/json-render": "workspace:*",
    "@devframes/json-render-ui": "workspace:*",
    "@devframes/plugin-a11y": "workspace:*",
    "@devframes/plugin-assets": "workspace:*",
    "@devframes/plugin-code-server": "workspace:*",
    "@devframes/plugin-data-inspector": "workspace:*",
    "@devframes/plugin-git": "workspace:*",
    "@devframes/plugin-inspect": "workspace:*",
    "@devframes/plugin-messages": "workspace:*",
    "@devframes/plugin-og": "workspace:*",
    "@devframes/plugin-terminals": "workspace:*",
    "@devframes/vite": "workspace:*",
    "devframe": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "vite": "catalog:build"
  }
}
